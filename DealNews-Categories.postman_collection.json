{
  "info": {
    "name": "Deal News - Category API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Mẫu test local cho Category API. Trong Variables, điền admin_email và admin_password của tài khoản administrator đang có. base_url mặc định http://localhost:8000; frontend_origin phải thuộc SANCTUM_STATEFUL_DOMAINS (local: http://localhost:3000). Chọn file ở Body > form-data > thumbnail của request 03, rồi gửi các request 01 đến 09 theo thứ tự. Collection dùng session cookie và tự cập nhật X-XSRF-TOKEN từ Set-Cookie; giữ cookie jar bật. Mỗi lượt chạy tạo category mới. API hiện chưa có chức năng xóa category, nên các category mẫu sẽ còn trong database local. Thumbnail nhận JPEG/PNG/WebP tối đa 10 MB, 8192 px mỗi chiều và 16 megapixels; kết quả là WebP không quá 20 KB. Chỉ dùng dữ liệu thử nghiệm trong môi trường local."
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "frontend_origin",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "admin_email",
      "value": "",
      "type": "string"
    },
    {
      "key": "admin_password",
      "value": "",
      "type": "string"
    },
    {
      "key": "xsrf_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "category_name",
      "value": "",
      "type": "string"
    },
    {
      "key": "category_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "thumbnail_path",
      "value": "",
      "type": "string"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const token = pm.collectionVariables.get('xsrf_token');",
          "if (!['GET', 'HEAD', 'OPTIONS'].includes(pm.request.method) && token) {",
          "    pm.request.headers.upsert({key: 'X-XSRF-TOKEN', value: token});",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.response.headers.all().forEach(function (header) {",
          "    if (header.key.toLowerCase() === 'set-cookie') {",
          "        const match = header.value.match(/^XSRF-TOKEN=([^;]*)/);",
          "        if (match) {",
          "            pm.collectionVariables.set('xsrf_token', decodeURIComponent(match[1]));",
          "        }",
          "    }",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 - Lấy CSRF cookie",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Origin",
            "value": "{{frontend_origin}}"
          }
        ],
        "url": "{{base_url}}/sanctum/csrf-cookie",
        "description": "Chạy đầu tiên để nhận session cookie và XSRF-TOKEN. Collection tự lưu token đã URL-decode."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('204 - CSRF cookie initialized', function () {",
              "    pm.response.to.have.status(204);",
              "    pm.expect(pm.collectionVariables.get('xsrf_token')).to.be.a('string').and.not.empty;",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Đăng nhập administrator",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Origin",
            "value": "{{frontend_origin}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/sign-in",
        "description": "Điền admin_email và admin_password trong Variables. Session và CSRF token được cập nhật tự động sau khi đăng nhập.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 - Administrator authenticated', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().data.user_role).to.eql('administrator');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Tạo category có thumbnail",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Origin",
            "value": "{{frontend_origin}}"
          }
        ],
        "url": "{{base_url}}/api/admin/categories",
        "description": "Body > form-data: thumbnail phải có kiểu File, chọn một ảnh JPEG/PNG/WebP trên máy. name và description có kiểu Text. Không đặt Content-Type thủ công; Postman tạo multipart boundary. name được tạo mới trước mỗi lần gửi để tránh trùng. Kết quả 201 chứa data.thumbnail là đường dẫn WebP, không phải URL.",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "name",
              "value": "{{category_name}}",
              "type": "text"
            },
            {
              "key": "thumbnail",
              "type": "file",
              "src": null,
              "description": "Chọn file JPEG/PNG/WebP tại đây trước khi gửi."
            },
            {
              "key": "description",
              "value": "Category tạo từ Postman để kiểm tra upload thumbnail.",
              "type": "text"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('category_name', 'Postman Category ' + pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 - Category created with an uploaded WebP thumbnail', function () {",
              "    pm.response.to.have.status(201);",
              "    const data = pm.response.json().data;",
              "    pm.expect(data.name).to.eql(pm.collectionVariables.get('category_name'));",
              "    pm.expect(data.thumbnail).to.be.a('string').and.match(/^images\\/[a-f0-9-]{36}\\/[a-f0-9-]{36}\\.webp$/);",
              "    pm.expect(data.total_articles).to.eql(0);",
              "    pm.collectionVariables.set('category_id', data.id);",
              "    pm.collectionVariables.set('thumbnail_path', data.thumbnail);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Danh sách categories",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Origin",
            "value": "{{frontend_origin}}"
          }
        ],
        "url": "{{base_url}}/api/admin/categories",
        "description": "Trả về danh sách phân trang, 10 category mỗi trang. Trường thumbnail giữ đường dẫn ảnh đã lưu."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 - Paginated category resources returned', function () {",
              "    pm.response.to.have.status(200);",
              "    const body = pm.response.json();",
              "    pm.expect(body.data).to.be.an('array');",
              "    pm.expect(body.meta.per_page).to.eql(10);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - Lấy URL thumbnail",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Origin",
            "value": "{{frontend_origin}}"
          }
        ],
        "url": "{{base_url}}/api/images?path={{thumbnail_path}}",
        "description": "Dùng đường dẫn nhận từ request 03. Ảnh thuộc administrator vừa đăng nhập. URL có chữ ký hết hạn sau một giờ nếu S3 không có AWS_URL public."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 - Thumbnail is a WebP image no larger than 20 KB', function () {",
              "    pm.response.to.have.status(200);",
              "    const data = pm.response.json().data;",
              "    pm.expect(data.path).to.eql(pm.collectionVariables.get('thumbnail_path'));",
              "    pm.expect(data.mime_type).to.eql('image/webp');",
              "    pm.expect(data.size).to.be.above(0).and.at.most(20480);",
              "    pm.expect(data.url).to.be.a('string').and.not.empty;",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "06 - Từ chối tên category trùng",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Origin",
            "value": "{{frontend_origin}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/admin/categories",
        "description": "Gửi lại đúng tên đã tạo ở request 03. Kết quả mong đợi là 422 với lỗi name.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{category_name}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('422 - Duplicate name rejected', function () {",
              "    pm.response.to.have.status(422);",
              "    pm.expect(pm.response.json().errors).to.have.property('name');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "07 - Từ chối dữ liệu không hợp lệ",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Origin",
            "value": "{{frontend_origin}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/admin/categories",
        "description": "Thiếu name và tự truyền slug. Kết quả 422 chứa cả hai lỗi; không tạo category.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"slug\": \"client-supplied-slug\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('422 - Missing name and client supplied slug rejected', function () {",
              "    pm.response.to.have.status(422);",
              "    pm.expect(pm.response.json().errors).to.have.property('name');",
              "    pm.expect(pm.response.json().errors).to.have.property('slug');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "08 - Tạo category không có thumbnail",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Origin",
            "value": "{{frontend_origin}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/admin/categories",
        "description": "Mẫu JSON khi không upload ảnh. Trường thumbnail có thể null hoặc bỏ trống.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman No Image {{$guid}}\",\n  \"thumbnail\": null,\n  \"description\": \"Category không có thumbnail.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 - Category created without a thumbnail', function () {",
              "    pm.response.to.have.status(201);",
              "    pm.expect(pm.response.json().data.thumbnail).to.eql(null);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "09 - Đăng xuất",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Origin",
            "value": "{{frontend_origin}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/sign-out",
        "description": "Kết thúc phiên đăng nhập. Để thử lại, chạy từ request 01.",
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 - Logged out', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().message).to.eql('Logged out successfully');",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
