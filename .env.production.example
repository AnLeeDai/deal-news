APP_NAME="Deal News"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Use custom domains sharing the same parent domain on Render and Vercel.
APP_URL=https://api.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
SANCTUM_STATEFUL_DOMAINS=app.example.com,api.example.com
TRUSTED_PROXIES=*
PORT=10000

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE

CACHE_STORE=database
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=.example.com
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=90

# Render's container filesystem is ephemeral. Use durable object storage.
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
# Set these for an S3-compatible provider such as R2, if needed.
AWS_ENDPOINT=https://YOUR_ACCOUNT.r2.cloudflarestorage.com
AWS_URL=https://media.example.com
AWS_USE_PATH_STYLE_ENDPOINT=false
MAIL_MAILER=log

# Web and worker are separate Render services, each with its own RAM budget.
OCTANE_SERVER=frankenphp
OCTANE_HTTPS=true
OCTANE_WORKERS=1
OCTANE_MAX_REQUESTS=500
GOMEMLIMIT=128MiB


ADMIN_EMAIL=dealnews@gmail.com
ADMIN_NAME="Dealnews Admin"
ADMIN_PASSWORD=Dealnews123!
ADMIN_ROLE=administrator
