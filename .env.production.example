APP_NAME="Deal News"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://news.example.com
TRUSTED_PROXIES=*
PORT=10000

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
# External MySQL URL. URL-encode special characters in the credentials.
DB_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE
# If the database provider supplies a CA, upload it as a Render secret file.
# MYSQL_ATTR_SSL_CA=/etc/secrets/mysql-ca.pem

CACHE_STORE=database
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=90

# Render's container filesystem is ephemeral. Use durable object storage.
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
# Set these for an S3-compatible provider such as R2, if needed.
# AWS_ENDPOINT=https://YOUR_ACCOUNT.r2.cloudflarestorage.com
# AWS_URL=https://media.example.com
AWS_USE_PATH_STYLE_ENDPOINT=false
MAIL_MAILER=log

# Web and worker are separate Render services, each with its own RAM budget.
PHP_THREADS=2
GOMEMLIMIT=128MiB
